# Copy to .env.local and fill in. Validated by src/lib/env.ts.
# Each becomes required in the PR that wires up its service.

# Neon Postgres, "dev" branch for local work (required).
# Pooled (-pooler host) for the app, direct for drizzle-kit migrations.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Clerk, development instance (required).
# Dashboard -> your app -> Configure -> API keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Signing secret (whsec_...) of the webhook endpoint for /api/webhooks/clerk, user.deleted
# (required). Dashboard -> Webhooks -> your endpoint.
CLERK_WEBHOOK_SIGNING_SECRET=

# Optional: the app's public origin, no path. Metadata, the Open Graph image, the sitemap,
# robots.txt and the MCP server's URL (<APP_URL>/mcp) use it. Production (Vercel):
# https://docchat.raheem.online. Locally, leave it unset for http://localhost:3000.
APP_URL=

# Vercel Blob, private store connected to the project's Development environment (required).
# `vercel env pull .env.local` adds it, or copy it from Storage -> your store -> .env.local.
BLOB_READ_WRITE_TOKEN=

# Embeddings: "google" (Gemini API; use a key from a project on the paid tier, whose content
# isn't used to improve Google's products) or "gateway" (Vercel AI Gateway, needs paid credits;
# optional). Defaults to google.
EMBEDDING_PROVIDER=google

# Answers: same choice and same rule as embeddings. Defaults to google.
CHAT_PROVIDER=google

# Optional: another answer model on CHAT_PROVIDER, e.g. gemini-3.8-flash. Unset uses the default.
CHAT_ANSWER_MODEL=

# Free-tier limits (src/lib/limits.ts, docs/adr/0010). All optional: leave unset for the
# default shown. Changing one on Vercel needs a redeploy (the landing page shows the document
# and daily question limits, read at build time). Daily limits reset at midnight UTC.
# Documents per user, in any state. Deleting one frees a slot. Default 3.
MAX_DOCUMENTS_PER_USER=
# Largest file in MB. Default 10.
MAX_FILE_MB=
# Pages read from one PDF; longer ones stop before anything is embedded. Default 50.
MAX_PAGES_PER_DOCUMENT=
# Questions per user: in any 60 seconds (default 5) and per UTC day (default 30).
QUESTIONS_PER_MINUTE=
QUESTIONS_PER_DAY=
# Task requests per user per UTC day (each is up to 5 model calls). Default 5.
AGENT_RUNS_PER_DAY=
# Longest question in characters. Default 500.
MAX_QUESTION_CHARS=
# Output tokens per answer (default 1500) and per agent step (default 4000), thinking included.
MAX_OUTPUT_TOKENS=
AGENT_MAX_OUTPUT_TOKENS=
# Earlier messages sent to the model with a question. Default 6 (three exchanges).
HISTORY_MESSAGES=
# Questions across all users per UTC day; past it, new questions and MCP searches pause
# until midnight UTC. Applies to everyone. Default 2000.
GLOBAL_QUESTIONS_PER_DAY=
# Searches from a user's connected AI app (MCP) per UTC day. Default 200.
MCP_SEARCHES_PER_DAY=
# Re-reading a failed document ("Try again") per user per hour. Default 10.
REINDEX_PER_HOUR=
# Clerk user ids that skip the per-user limits (for demos), comma-separated. Ids differ per
# Clerk instance: use the development instance's here, the production instance's on Vercel.
UNLIMITED_USER_IDS=

# Gemini API key for EMBEDDING_PROVIDER=google and CHAT_PROVIDER=google.
# https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=

# Vercel AI Gateway, for EMBEDDING_PROVIDER=gateway and CHAT_PROVIDER=gateway.
# Vercel dashboard -> AI Gateway -> API keys. Not needed on Vercel deployments, which
# authenticate with the project's OIDC token.
AI_GATEWAY_API_KEY=

# Optional: Sentry error monitoring (docs/launch-checklist.md, step 5). Unset: off. Locally,
# leave it unset unless you're testing monitoring itself.
SENTRY_DSN=
# Build only: source map upload. All three, or none.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Playwright's signed-in specs: a user on the Clerk DEVELOPMENT instance with a +clerk_test
# address (no email sent, code 424242). tests/e2e/global-setup.ts creates it if it's missing,
# with this password (16+ random characters). CI has both as repository secrets.
E2E_CLERK_USER_EMAIL=
E2E_CLERK_USER_PASSWORD=

# Test doubles, for the e2e tests only (docs/adr/0009). Allowed only when CI is set or under
# Vitest, never on Vercel; the server refuses to start with them otherwise:
#   EMBEDDING_PROVIDER=fake CHAT_PROVIDER=fake STORAGE_DRIVER=local
