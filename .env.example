# Copy to .env.local and fill in. Validated by src/lib/env.ts.
# Each becomes required in the PR that wires up its service.

# Neon Postgres, "dev" branch for local work (required).
# Pooled (-pooler host) for the app, direct for drizzle-kit migrations.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Clerk, development instance (required).
# Dashboard -> your app -> Configure -> API keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Signing secret (whsec_...) of the webhook endpoint for /api/webhooks/clerk, user.deleted
# (required). Dashboard -> Webhooks -> your endpoint.
CLERK_WEBHOOK_SIGNING_SECRET=

# Vercel Blob, private store connected to the project's Development environment (required).
# `vercel env pull .env.local` adds it, or copy it from Storage -> your store -> .env.local.
BLOB_READ_WRITE_TOKEN=

# Embeddings: "google" (Gemini API free tier, development with fictional documents only) or
# "gateway" (Vercel AI Gateway, needs paid credits; production uses this). Defaults to google.
EMBEDDING_PROVIDER=google

# Answers: same choice and same rule as embeddings. Defaults to google.
CHAT_PROVIDER=google

# Optional: another answer model on CHAT_PROVIDER, e.g. gemini-3.8-flash. Unset uses the default.
CHAT_ANSWER_MODEL=

# Answers one user may generate per UTC day (the free tier's daily quota is shared). Unset: 10
# with CHAT_PROVIDER=google, 50 with gateway.
CHAT_DAILY_LIMIT=

# Gemini API key for EMBEDDING_PROVIDER=google and CHAT_PROVIDER=google.
# https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=

# Vercel AI Gateway, for EMBEDDING_PROVIDER=gateway and CHAT_PROVIDER=gateway.
# Vercel dashboard -> AI Gateway -> API keys. Not needed on Vercel deployments, which
# authenticate with the project's OIDC token.
AI_GATEWAY_API_KEY=

# Optional: Sentry error monitoring (docs/launch-checklist.md, step 5). Unset: off. Locally,
# leave it unset unless you're testing monitoring itself.
SENTRY_DSN=
# Build only: source map upload. All three, or none.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Playwright's signed-in specs: a user on the Clerk DEVELOPMENT instance with a +clerk_test
# address (no email sent, code 424242). tests/e2e/global-setup.ts creates it if it's missing,
# with this password (16+ random characters). CI has both as repository secrets.
E2E_CLERK_USER_EMAIL=
E2E_CLERK_USER_PASSWORD=

# Test doubles, for the e2e tests only (docs/adr/0009). Allowed only when CI is set or under
# Vitest, never on Vercel; the server refuses to start with them otherwise:
#   EMBEDDING_PROVIDER=fake CHAT_PROVIDER=fake STORAGE_DRIVER=local
